# Copy to .env (git-ignored). Names only — never commit real values.

# ---- Backend (read by FastAPI; never exposed to the browser) ----
GEMINI_API_KEY=
GEMINI_MODEL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOLVER_TIME_LIMIT_SECONDS=2
BENCHMARK_RUNS_ENABLED=true

# ---- Frontend (build-time, public by design — never put secrets here) ----
# Absolute HTTPS URL of the deployed backend; leave empty in dev (Vite proxies /v1 to :8000).
VITE_API_BASE_URL=
# Sub-path for GitHub Pages, e.g. /DOMINO/ ; leave empty for local dev.
VITE_BASE_PATH=
